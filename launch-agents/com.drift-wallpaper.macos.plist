<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Unique identifier for this Launch Agent. -->
    <key>Label</key>
    <string>com.drift-wallpaper.macos</string>

    <!-- Absolute path to the installed binary.
         The {BIN} placeholder is replaced by drift-app at runtime when the
         user enables "Start at Login". -->
    <key>ProgramArguments</key>
    <array>
        <string>{BIN}</string>
    </array>

    <!-- Start at login. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Keep alive if it exits unexpectedly. -->
    <key>KeepAlive</key>
    <true/>

    <!-- Standard output / error logging. -->
    <key>StandardOutPath</key>
    <string>/tmp/drift-wallpaper.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/drift-wallpaper.err</string>
</dict>
</plist>
